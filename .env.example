# ── Required ─────────────────────────────────────────────────────────────

# Signs the session cookie. Generate one with: openssl rand -hex 32
SECRET_KEY=

# Google OAuth credentials from console.cloud.google.com.
# Authorised redirect URI must be:  https://<your-domain>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who can sign in. The first address is the owner and gets admin rights.
# Everyone else can be added from the Setup page once you're in.
ALLOWED_EMAILS=you@gmail.com

# The season the optimiser is planning for. Must not appear in the engine's
# PAST_SEASONS list.
CURRENT_SEASON=2026-27


# ── Provided by Railway; only set these locally ──────────────────────────

# Railway's Postgres plugin injects this. Falls back to SQLite if unset.
# DATABASE_URL=postgresql://user:pass@localhost:5432/nerdball

# Railway sets RAILWAY_PUBLIC_DOMAIN, which is used to build the OAuth
# callback. Set PUBLIC_BASE_URL only if you're on a custom domain.
# PUBLIC_BASE_URL=https://nerdball.example.com


# ── Optional ─────────────────────────────────────────────────────────────

# Seat cap. Six covers you plus five friends. Guests don't take a seat.
MAX_USERS=6

# Offers "Continue without signing in" on the sign-in page. A guest gets a
# throwaway account with the tuning fixed and nothing saved: see
# web/backend/app/guest.py for exactly what that means. Set to false to
# take the option away entirely.
GUEST_MODE=true

# How long an idle guest account survives before it is swept up. Active
# sessions are kept alive as they're used, so this is a floor, not a
# session length.
GUEST_TTL_HOURS=24

# ── Email notifications ──────────────────────────────────────────────────
#
# Access requests and feedback always land in the admin inbox. These send
# you an email as well, so you find out without going to look. Leave
# MAIL_TO unset and nothing is sent — everything still gets saved.
MAIL_TO=you@gmail.com

# Two ways to send. Resend is an HTTP API, so it works even where a host
# blocks outbound SMTP, and you can send from your own domain once it's
# verified with them. Create a key at resend.com and set:
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Fantasy Nerdball <alerts@fplnerdball.com>
#
# Or plain SMTP. For Gmail you need an app password, not your normal one
# (Google Account → Security → 2-Step Verification → App passwords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# MAIL_FROM=you@gmail.com

# uvicorn worker processes, and so how many optimisations can run at
# once: os.chdir is process-wide, so one process means one run at a time
# whatever the container's core count. Read web/CAPACITY.md before
# raising it — the limit is memory, and the admin Usage tab measures it.
WEB_CONCURRENCY=1

# Structured JSON logs on stdout, which is what lets Railway's
# Observability dashboard filter on attributes. See web/OBSERVABILITY.md
# for the events and the filters that chart them. Defaults to false when
# DEV_MODE is on, where a person is reading the terminal.
LOG_JSON=true

# One http_request event per API call. Turn off if log volume ever
# becomes the cost rather than the insight.
LOG_REQUESTS=true

# How often the app writes its own totals (managers, live guests, runs in
# the last 24h, queue depth) to the log. 0 switches it off.
HEARTBEAT_MINUTES=15

# Keeps a queryable copy of the meaningful events in the database, which
# is what the Usage tab in the admin pane reads.
METRICS=true
METRICS_RETENTION_DAYS=90

# How much of a guest's address is kept so the dashboard can tell one
# anonymous visitor from another. "truncated" stores the /24 they came
# from, "full" the address itself, "none" neither. Unique visitors are
# counted from a salted hash either way, so counting works even on
# "none" — this only governs what an admin can see. An IP address is
# personal data under UK GDPR: don't set this to full on a public site
# without a privacy notice saying so.
VISITOR_IP_MODE=truncated

# Gates the admin page, reached from the small link in the footer. Leave it
# unset and the admin page stays locked for everyone.
ADMIN_PASSWORD=

# How long an unlock lasts before the password is asked for again.
ADMIN_SESSION_MINUTES=30

# Authorises the scheduled-maintenance endpoint at /api/cron/update-history.
# Only needed if you want an external scheduler to trigger updates; leave it
# unset and the endpoint stays closed. Generate with: openssl rand -hex 24
CRON_SECRET=

# The app tops up player history on its own timer. Set to false if you'd
# rather an external scheduler owned it.
HISTORY_AUTO_UPDATE=true
HISTORY_CHECK_MINUTES=60

# Where squads and cached reference data live. Point this at a Railway
# volume mount so it survives redeploys.
NERDBALL_DATA_DIR=/data

# Local development only: skips Google and signs you in directly.
# DEV_MODE=true
# DEV_LOGIN_EMAIL=you@gmail.com
