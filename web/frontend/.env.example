# ── Required ─────────────────────────────────────────────────────────────

# Signs the session cookie. Generate one with: openssl rand -hex 32
SECRET_KEY=

# Google OAuth credentials from console.cloud.google.com.
# Authorised redirect URI must be:  https://<your-domain>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who can sign in. The first address is the owner and gets admin rights.
# Everyone else can be added from the Setup page once you're in.
ALLOWED_EMAILS=you@gmail.com

# The season the optimiser is planning for. Must not appear in the engine's
# PAST_SEASONS list.
CURRENT_SEASON=2026-27


# ── Provided by Railway; only set these locally ──────────────────────────

# Railway's Postgres plugin injects this. Falls back to SQLite if unset.
# DATABASE_URL=postgresql://user:pass@localhost:5432/nerdball

# Railway sets RAILWAY_PUBLIC_DOMAIN, which is used to build the OAuth
# callback. Set PUBLIC_BASE_URL only if you're on a custom domain.
# PUBLIC_BASE_URL=https://nerdball.example.com


# ── Optional ─────────────────────────────────────────────────────────────

# Seat cap. Six covers you plus five friends.
MAX_USERS=6

# Where squads and cached reference data live. Point this at a Railway
# volume mount so it survives redeploys.
NERDBALL_DATA_DIR=/data

# Local development only: skips Google and signs you in directly.
# DEV_MODE=true
# DEV_LOGIN_EMAIL=you@gmail.com
